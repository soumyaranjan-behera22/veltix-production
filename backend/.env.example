# Port the server listens on. Railway sets this automatically in production.
PORT=8080

# Required — get one at https://resend.com. Used to send the admin
# notification email and the visitor auto-reply for the contact form.
RESEND_API_KEY=re_your_resend_api_key

# Optional — comma-separated list of allowed origins for CORS, e.g.
# https://your-frontend.vercel.app. If unset, all origins are allowed,
# which is fine for local dev but should be restricted in production.
CORS_ORIGIN=
